# Copy to operator.local.env (gitignored). Never commit operator.local.env.
# Do not put real hostnames, users, or forge URLs you care about into tracked files — keep them here only.
# See docs/OPERATOR-LOCAL.md

# Required for scripts/deploy-gb10.sh (unless you pass DEPLOY_HOST= for a one-off). Legacy alias: deploy-gx10.sh
# Example: rsync + remote npm build + systemd user restart on your GB10-class inference host (use your real user@host):
DEPLOY_SSH=operator@your-inference-host.example

# Remote directory for rsync + build: path relative to *remote* $HOME, or absolute on the host.
# Do not use ~ here — it would expand on the machine running deploy when this file is sourced.
# DEPLOY_REMOTE_PATH=repos/recipe-deck

# Optional: where this repo lives on your forge (for runbooks / tickets only; not read by scripts).
# GIT_REMOTE_SSH_URL=ssh://git@your-forge.example:2222/your-org/recipe-deck.git
